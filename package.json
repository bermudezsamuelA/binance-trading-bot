{
  "name": "binance-trading-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:python": "cd binance-research && .venv\\Scripts\\python -u server.py",
    "start:node": "npx tsx src/index.ts",
    "dev": "concurrently --kill-others-on-fail -c \"cyan.bold,green.bold\" -n \"BRAIN,HANDS\" \"npm run start:python\" \"npm run start:node\"",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:python": "cd binance-research && .venv\\Scripts\\python -m unittest test_ledger test_report test_server test_strategy_engine test_walk_forward test_filters test_meta_filter -v",
    "test:v3": "cd binance-research && .venv\\Scripts\\python -m unittest discover -s v3_research/shadow -p \"test_*.py\" -v",
    "v3:shadow": "cd binance-research && .venv\\Scripts\\python v3_research\\shadow\\run_daily.py --download"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "crypto": "^1.0.1",
    "dotenv": "^18.0.4",
    "ws": "^8.22.0",
    "zeromq": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
